# OCI Autonomous DB
DB_USER=
DB_PASSWORD=
DB_DSN=
DB_WALLET_DIR=
DB_WALLET_PASSWORD=

# OCI Object Storage (S3-compatible API)
OCI_OS_NAMESPACE=
OCI_OS_BUCKET=
OCI_OS_REGION=
OCI_OS_ACCESS_KEY=
OCI_OS_SECRET_KEY=

# OCI Generative AI (advanced vision analysis, see genai_vision.py)
OCI_GENAI_REGION=
OCI_GENAI_COMPARTMENT_ID=
OCI_GENAI_MODEL_ID=
OCI_GENAI_CONFIG_PROFILE=

# OCI Generative AI (visual SKU matching, see image_embed.py; shares the
# region/compartment/config profile above)
OCI_GENAI_EMBED_MODEL_ID=

# OCI Generative AI (ASKU grounded analytics chat, see asku.py; shares the
# region/compartment/config profile above -- must be a CHAT-capability text
# model, not the vision model in OCI_GENAI_MODEL_ID)
OCI_GENAI_CHAT_MODEL_ID=

# Campus fleet status thresholds (see fleet.py; both optional, defaults in code)
FLEET_STALE_MINUTES=
FLEET_SERVICE_THRESHOLD_PERCENT=

# Can the live camera rig feeds, as a CANS.CAN_CODE (see camera_service.py;
# optional, and used only for that rig's captures -- when empty, they are
# logged with no can attributed to them. Every other capture is attributed by
# matching its own LOCATION against CANS.CAN_CODE, so a capture with no
# location, or one naming no registered can, is never credited to this can)
LIVE_CAMERA_CAN_CODE=
